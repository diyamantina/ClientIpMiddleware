#!/bin/sh
# Commit-message gate. Refuses em dashes (U+2014) and AI-attribution tells, and
# requires a CHANGELOG entry when production source changes. Portable POSIX sh,
# BSD-grep compatible, no PCRE. Install with: git config core.hooksPath .githooks
#
# The em-dash byte pattern is built with printf so this script contains no
# literal U+2014 and does not trip its own check or the CI scan.

msg_file="$1"
emdash=$(printf '\342\200\224')

# Strip comment lines and the verbose-diff scissors block before checking, so
# notes in "# ..." lines and the appended diff are not penalised.
clean=$(sed -e '/^#/d' -e '/^-* >8 -*$/,$d' "$msg_file")

fail=0

if printf '%s\n' "$clean" | LC_ALL=C grep -q "$emdash"; then
    echo "commit-msg: em dash (U+2014) is not allowed. Use a comma, period, or colon." >&2
    fail=1
fi

# High-signal AI-attribution tells. Deliberately narrow to avoid false positives
# on this repo's domain words (for example "User-Agent", "OpenAPI-generated").
if printf '%s\n' "$clean" | grep -iE 'co-authored-by:[^@]*(claude|copilot|chatgpt)|generated (with|by)[^.]{0,30}(claude|copilot|chatgpt)|claude code|anthropic|🤖' >/dev/null; then
    echo "commit-msg: remove the AI-attribution / tool reference from the message." >&2
    fail=1
fi

# CHANGELOG gate: production source touched without a CHANGELOG entry.
# Opt out with [no-changelog] in the commit body when no entry is warranted.
if ! printf '%s\n' "$clean" | grep -q '\[no-changelog\]'; then
    staged=$(git diff --cached --name-only)
    src=$(printf '%s\n' "$staged" | grep -E '^Sources/.*\.swift$' || true)
    chg=$(printf '%s\n' "$staged" | grep -E '^CHANGELOG\.md$' || true)
    if [ -n "$src" ] && [ -z "$chg" ]; then
        echo "commit-msg: production source changed but CHANGELOG.md is not staged." >&2
        echo "  Add an entry under [Unreleased], or put [no-changelog] in the commit body." >&2
        fail=1
    fi
fi

exit $fail
